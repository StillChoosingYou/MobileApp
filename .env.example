# Copy this file to .env (same folder) and fill in real values.
# .env is already covered by .gitignore — never commit real credentials.

# Supabase's Transaction mode (Supavisor) connection string — port 6543.
# Get this from: Supabase dashboard → Project Settings → Database →
# Connection string → "Transaction" mode. Do NOT use the direct connection
# (port 5432, db.<ref>.supabase.co) — see the comment in api/db.py for why.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Any long random string — used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string
